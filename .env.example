# Local XAMPP MariaDB/MySQL connection. Copy to .env.local and set a password.
DATABASE_URL=mysql://whizzkids_app:CHANGE_ME@localhost:3306/whizzkids
DB_CONNECTION_LIMIT=3

# Required in production for rate limits shared across Vercel instances.
# Create a Redis database with REST access and set its URL/token in Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
